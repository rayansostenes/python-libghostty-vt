# Bundle what the raw-layer extension needs to build from an sdist: the
# pinned-commit file, the build shim, and the vendored upstream source (the
# libghostty-vt-only dist tarball, not the full Ghostty tree; see
# scripts/fetch-vendor.sh). The zig package cache is deliberately NOT bundled:
# the union of per-target dependencies exceeds PyPI's file size limit, so a
# bare sdist build lets zig fetch the build.zig.zon-pinned, hash-verified
# dependencies over the network. Builds from a repo checkout or in wheel CI
# run hermetically against the populated vendor/zig-cache instead (see
# _cffi_build.py).

include ghostty-commit.txt
include setup.py
recursive-include scripts *.sh
# The generated raw-layer cdef consumed by the build at wheel/sdist time.
include src/ghostty_vt/_cdef.h

# Vendored upstream source (headers + zig build inputs).
graft vendor/ghostty
# Host build artifacts from an in-tree build; zig rebuilds these, so shipping
# them only bloats the sdist.
prune vendor/ghostty/.zig-cache

# Never ship compiled extensions in the sdist; they are built per-platform.
global-exclude *.so *.pyd *.dylib *.a
