# Bundle everything the raw-layer extension needs to build offline from an
# sdist: the pinned-commit file, the build shim, the vendored upstream source,
# and the prefetched zig package cache. With these present, a wheel build never
# touches the network.

include ghostty-commit.txt
include setup.py
recursive-include scripts *.sh
# The generated raw-layer cdef consumed by the build at wheel/sdist time.
include src/ghostty_vt/_cdef.h

# Vendored upstream source (headers + zig build inputs).
graft vendor/ghostty
prune vendor/ghostty/.git
# Host build artifacts from an in-tree build; zig rebuilds these from the
# prefetched package cache, so shipping them only bloats the sdist.
prune vendor/ghostty/.zig-cache

# Prefetched zig dependencies: ship only the source-package cache (p/). Zig
# rebuilds every other cache directory from it, so the local build-artifact and
# hash-manifest caches are intentionally omitted (shipping stale h/ manifests
# without their o/ outputs would break the offline build).
graft vendor/zig-cache/p

# Never ship compiled extensions in the sdist; they are built per-platform.
global-exclude *.so *.pyd *.dylib *.a
